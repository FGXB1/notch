# Settings for Scripts/release.sh. Nothing here is secret: the Sparkle key is the public half (the private
# half stays in your login keychain), and the team ID is printed in every signed copy of the app.

# Your paid Apple Developer Program team ID (developer.apple.com/account › Membership details). Empty:
# releases are signed with your Apple Development certificate and not notarized, so people have to clear
# macOS's quarantine flag before Notch will open.
DEVELOPER_ID_TEAM=""

# The notarytool keychain profile holding your notarization credentials, created once with:
#   xcrun notarytool store-credentials notch-notary --apple-id <your Apple ID> --team-id <DEVELOPER_ID_TEAM>
NOTARY_PROFILE="notch-notary"

# The GitHub "owner/repo" whose releases host the disk images and appcast.xml, e.g. "ishan/notch". It has
# to be public for downloads and updates to work. Empty: releases can't update themselves.
GITHUB_REPO="FGXB1/notch"

# Sparkle's public EdDSA key. `Scripts/release.sh keys` fills it in.
SPARKLE_PUBLIC_KEY="zu1GWir603L4ePecdTRAfOVHCUYLBn1AA19UjKEO+TE="
